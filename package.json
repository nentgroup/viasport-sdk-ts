{
  "name": "@viaplay/viasport-sdk-ts",
  "version": "0.3.0",
  "description": "TypeScript SDK for Viasport services",
  "type": "commonjs",
  "license": "MIT",
  "private": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.mjs",
      "require": "./dist/sdk.js"
    },
    "./service/search": {
      "types": "./dist/service/search/index.d.ts",
      "import": "./dist/service/search/index.mjs",
      "require": "./dist/service/search/index.js"
    }
  },
  "scripts": {
    "clean": "task clean",
    "generate": "task generate:all",
    "build": "tsup src/index.ts src/sdk.ts src/service/search/index.ts --format cjs,esm --dts --out-dir dist --clean",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --color",
    "prettier": "prettier --check .",
    "prettier-fix": "prettier --write .",
    "test": "npm run build && node --test test/*.test.cjs",
    "ci": "task ci"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "eslint": "^10.0.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
